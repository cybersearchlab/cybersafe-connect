# =============================================================================
# CyberSafe Connect - Scam Checker Microservice — example configuration
# =============================================================================
# Copy this file to .env and fill in real values. .env is gitignored and
# must NEVER be committed — this file only ever holds placeholders.
# =============================================================================

ENVIRONMENT=development
PORT=8002
DATABASE_URL=sqlite:///./data/scam_checker.db

# This service never issues tokens, it only validates ones issued by the
# auth service — JWT_SECRET_KEY and JWT_ALGORITHM MUST match
# services/auth/.env exactly, or every token verification fails.
JWT_SECRET_KEY=replace_me_same_value_as_auth_service
JWT_ALGORITHM=HS256

# Plain comma-separated list — NOT a JSON array (see services/auth/.env.example).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Scoring thresholds ---
# ROUGE >= 70, ORANGE 30-69, VERT < 30
SCORE_ROUGE_THRESHOLD=70
SCORE_ORANGE_THRESHOLD=30

# --- Rate limiting (anti-abuse) ---
RATE_LIMIT_CHECK=30/minute
RATE_LIMIT_REPORT=10/minute
MAX_TEXT_LENGTH=2000

# --- Report evidence uploads ---
EVIDENCE_DIR=./data/evidence
MAX_EVIDENCE_SIZE_MB=5
MAX_EVIDENCE_PER_REPORT=5

# --- Report burst / coordination detection (admin queue priority signal) ---
BURST_MIN_REPORTS=3
BURST_WINDOW_MINUTES=5
